{
    "geode": "5.10.1"
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081"
    },
    "id": "owenpro.frame-perfect-meter",
    "name": "Frame Perfect Meter",
    "version": "v1.0.0",
    "developer": "owenpro",
    "description": "Contador de frame perfects con sonido y selección de FPS.",
    "settings": {
        "enabled": {
            "type": "bool",
            "name": "Activado",
            "default": true
        },
        "fps-list": {
            "type": "string",
            "name": "FPS a detectar",
            "description": "FPS separados por comas. Ej: 30,60,80,120,240",
            "default": "30,60,80,120,240"
        },
        "tps": {
            "type": "int",
            "name": "TPS de física",
            "description": "Pasos de física por segundo del juego (240 por defecto).",
            "default": 240,
            "min": 1,
            "max": 100000
        },
        "tolerance": {
            "type": "int",
            "name": "Tolerancia (steps)",
            "description": "Steps extra permitidos además de 1 frame. 0 = estricto.",
            "default": 0,
            "min": 0,
            "max": 16
        },
        "play-sound": {
            "type": "bool",
            "name": "Sonido",
            "default": true
        },
        "volume": {
            "type": "float",
            "name": "Volumen",
            "default": 1.0,
            "min": 0.0,
            "max": 1.0,
            "control": {
                "slider": true
            }
        },
        "reset-on-restart": {
            "type": "bool",
            "name": "Reiniciar contador al morir",
            "default": true
        }
    }
}
