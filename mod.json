geode": "4.6.1",
"gd": { "android": "2.2074" },
"id": "owenpro2016.inputassist",
"name": "InputAssist",
"version": "v1.0.0",
"developer": "tu-usuario",
"description": "Asistencia de entrada pensada para movil: clicks alineados al frame, retencion de clicks tempranos, wave recta y vuelo estable. Todo dentro del tick de fisica, sin hilos ni timers.",
"repository": "https://github.com/tu-usuario/InputAssist",
"platforms": ["android32", "android64"],
"settings": {
"enabled": { "type": "bool", "default": true, "name": "Activar InputAssist", "description": "Interruptor general. Apagado = comportamiento original." },
"profile": { "type": "string", "default": "balanced", "one-of": ["off","soft","balanced","aggressive","custom"], "name": "Perfil", "description": "off / soft / balanced / aggressive / custom." },
"alignMode": { "type": "string", "default": "aligned", "one-of": ["off","aligned","offset"], "name": "Alineacion de clicks", "description": "off = passthrough. aligned = siguiente tick. offset = + desfase." },
"alignOffset": { "type": "int", "default": 0, "min": -3, "max": 3, "control": { "type": "slider" }, "name": "Desfase (frames)", "description": "Frames extra de retraso. Valores negativos se convierten a 0." },
"retainEnabled": { "type": "bool", "default": true, "name": "Retener clicks tempranos" },
"retainWindowMs": { "type": "int", "default": 120, "min": 20, "max": 300, "control": { "type": "slider" }, "name": "Ventana retencion (ms)" },
"retainWindowFrames": { "type": "int", "default": 8, "min": 1, "max": 30, "control": { "type": "slider" }, "name": "Ventana retencion (frames)" },
"adaptiveEnabled": { "type": "bool", "default": false, "name": "Modo adaptativo" },
"adaptiveWindow": { "type": "int", "default": 45, "min": 20, "max": 80, "control": { "type": "slider" }, "name": "Ventana adaptativa (clicks)" },
"adaptiveMaxStep": { "type": "float", "default": 0.08,"min": 0.01, "max": 0.5, "control": { "type": "slider" }, "name": "Paso maximo adaptativo" },
"waveEnabled": { "type": "bool", "default": true, "name": "Wave recta" },
"wavePulseTicks": { "type": "int", "default": 2, "min": 1, "max": 4, "control": { "type": "slider" }, "name": "Duracion de micro-pulso (ticks)" },
"flightEnabled": { "type": "bool", "default": true, "name": "Vuelo estable (ship/UFO)" },
"flightDamping": { "type": "float", "default": 0.55,"min": 0.1, "max": 0.9, "control": { "type": "slider" }, "name": "Amortiguacion de vuelo" },
"flightMaxCorrections": { "type": "int","default": 8, "min": 2, "max": 30, "control": { "type": "slider" }, "name": "Correcciones maximas por segundo" },
"obstacleRadius": { "type": "int", "default": 3, "min": 1, "max": 5, "control": { "type": "slider" }, "name": "Radio de analisis (bloques)" },
"showIndicator": { "type": "bool", "default": true, "name": "Mostrar indicador en pantalla" },
"indicatorX": { "type": "float", "default": 0.9, "min": 0.0, "max": 1.0, "control": { "type": "slider" }, "name": "Indicador X (0-1)" },
"indicatorY": { "type": "float", "default": 0.15,"min": 0.0, "max": 1.0, "control": { "type": "slider" }, "name": "Indicador Y (0-1)" },
"perLevelProfiles": { "type": "bool", "default": false, "name": "Guardar ajustes por nivel" }
}
}
FIN
